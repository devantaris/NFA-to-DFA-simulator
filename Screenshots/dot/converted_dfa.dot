digraph Automaton {
  rankdir=LR;
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];
  label="Converted DFA";
  labelloc="t";
  fontsize=13;

  // Start state arrow
  __start__ [shape=none, label="", width=0, height=0];
  __start__ -> "q0";

  node [shape=doublecircle, style=filled, fillcolor="#E8F5E9"]; "q2";
  node [shape=circle, style=filled, fillcolor="#F5F5F5"]; "q0" "q1";

  // Transitions
  "q0" -> "q0" [label="1"];
  "q0" -> "q1" [label="0"];
  "q1" -> "q1" [label="0"];
  "q1" -> "q2" [label="1"];
  "q2" -> "q0" [label="1"];
  "q2" -> "q1" [label="0"];
}